# =============================================================================
# NostrFeed Mobile — build-time environment
# =============================================================================
# Copy to `.env` and fill in real values. `.env` is gitignored — never commit
# it. This file is consumed via `--dart-define-from-file=.env`:
#
#   flutter run --dart-define-from-file=.env
#   flutter build apk --dart-define-from-file=.env
#
# Or regenerate `dart_defines.json` (used by IDE launch configs):
#
#   dart run tool/gen_dart_defines.dart
#
# IMPORTANT: dart-define values end up inside the built APK/IPA. Treat them
# as extractable — only ship keys that are harmless when public:
#   ✓ receive-only LNbits invoice keys (cannot spend)
#   ✓ zero-credit OpenRouter free-tier keys (keep dashboard credit limit = 0)
#   ✗ NEVER an LNbits ADMIN key, spending key, or paid OpenRouter key without
#     a hard credit cap.
# =============================================================================

# ---------------------------------------------------------------------------
# OpenRouter (AI) — direct from app, no proxy
# ---------------------------------------------------------------------------
# FREE-tier inference key (sk-or-v1-...). Free quota: 50 req/day per key,
# shared across all app users (1,000/day after a one-time $10 top-up on the
# OpenRouter account). Keep this key's credit limit at 0 in the dashboard.
OPENROUTER_API_KEY=

# Optional: override the OpenRouter base URL (rarely needed).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ---------------------------------------------------------------------------
# LNbits house wallet (receive-only) — enables in-app invoice flows
# ---------------------------------------------------------------------------
# The wallet lives on the LNbits instance below — URL + credentials must come
# from the SAME instance or every call 401s. Invoice key CANNOT spend.
# Web-app source of truth: root .env (VITE_LNBITS_URL / VITE_LNBITS_WALLET_ID /
# VITE_LNBITS_INVOICE_KEY).
LNBITS_URL=
LNBITS_WALLET_ID=
LNBITS_INVOICE_KEY=

# ---------------------------------------------------------------------------
# The following have working public defaults in lib/core/config/env.dart —
# only set them here to OVERRIDE (staging instances, rebrand, …):
#   CASHU_MINT_URL                 https://mint.nostrfeed.com
#   LIGHTNING_ADDRESS_DOMAIN       ln.nostrfeed.com
#   LIGHTNING_ADDRESS_DOMAINS      (extra lnurlp domains, space/comma list)
#   FREE_LIGHTNING_ADDRESS_DOMAIN  (default: none)
#   NIP5_DOMAIN_ID                 i3KUfyMGodpcVZqFqGf2Wx
#   NIP5_DOMAIN                    ln.nostrfeed.com
#   NIP5_DOMAINS                   2sJcjWPRQEDinLcENtPtJs:getzap.me
#   PAID_RELAY                     wss://paid.nostrfeed.com
#   PAID_RELAY_ADMISSION           (default: derived from PAID_RELAY)
#   BLOSSOM_SERVERS                (default: built-in fallback list)
#   GETZAP_API                     https://api.getzap.me/v1
#   FIAT_PROVIDER                  paypal
#   PREMIUM_MONTHLY_LINK / PREMIUM_LIFETIME_LINK        (empty = sats-only)
#   PREMIUM_MONTHLY_FIAT_PLAN / PREMIUM_LIFETIME_FIAT_PLAN
# =============================================================================
