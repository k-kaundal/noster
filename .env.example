# Copy to `.env` and fill in. Values here are examples, not real credentials.
#
# IMPORTANT: Vite inlines every VITE_-prefixed variable into the built
# JavaScript. Treat all of them as public. Never put a spending key here.

# Our LNbits instance. Public.
VITE_LNBITS_URL=https://ln.nostrfeed.com

# Optional house wallet, used only to receive.
#
# The invoice key can create invoices and read the wallet balance. It cannot
# spend. It is still published in the bundle, so anyone can see that balance —
# only set this if that is acceptable for the wallet in question.
VITE_LNBITS_WALLET_ID=
VITE_LNBITS_INVOICE_KEY=

# Domain for user lightning addresses (name@domain).
#
# Defaults to the LNbits host, which works with no extra setup because LNbits
# serves its own /.well-known/lnurlp route. Set this to the apex domain only
# once that domain proxies /.well-known/lnurlp/* to LNbits — see
# docs/lightning-addresses.md.
VITE_LIGHTNING_ADDRESS_DOMAIN=

# Verified names (NIP-05), sold by the LNbits `nostrnip5` extension.
#
# Not the same thing as the lightning address above, even though both are
# written `name@domain`. That one is a free permanent pay link. This one is a
# name rented by the year, with an expiry, and it is what makes other clients
# show a checkmark next to someone.
#
# The extension has no public endpoint listing domains — reading one needs an
# admin key — so the domain's id has to be configured here. Find it in the URL
# of the domain's page in the LNbits nostrnip5 extension. Left blank, the whole
# feature is hidden rather than offering a name we cannot issue.
#
# The domain name itself defaults to VITE_LIGHTNING_ADDRESS_DOMAIN, which is
# right when both are sold under one name. Set it only when they differ.
#
# Requires: the nostrnip5 extension installed and enabled, a domain created in
# it, and that domain's DNS pointing /.well-known/nostr.json at LNbits.
VITE_NIP5_DOMAIN_ID=
VITE_NIP5_DOMAIN=

# Paid relay access. Ids from the LNbits pay link URLs
# (https://ln.nostrfeed.com/lnurlp/link/<id>). A full URL works too.
#
# Left blank, the app falls back to NostrFeed's own links. A pay link id is
# public — it is the address of a payment page — so this is configuration, not
# a secret. Set these to sell access through different links.
VITE_PREMIUM_MONTHLY_LINK=
VITE_PREMIUM_LIFETIME_LINK=

# Card and PayPal subscriptions, brokered by LNbits' fiat providers.
#
# The plan itself lives with the provider — create a PayPal billing plan (or a
# Stripe price) and put its id here. LNbits charges it on schedule and credits
# the wallet named by VITE_LNBITS_WALLET_ID, so that variable and the invoice
# key above must be set for these to appear.
#
# The provider must also be switched on in the LNbits admin settings
# (paypal_enabled, paypal_client_id, paypal_client_secret, paypal_webhook_id)
# and permitted for the paying account.
VITE_FIAT_PROVIDER=paypal
VITE_PREMIUM_MONTHLY_FIAT_PLAN=
VITE_PREMIUM_LIFETIME_FIAT_PLAN=

# There is deliberately no admin key here. An admin key can drain the wallet,
# and this app is a static site with no server to hide one behind. Spending is
# done with the signed-in user's own wallet, authorised per user via NIP-98.

# Media servers, tried in order until one accepts the upload.
#
# Blossom addresses files by their hash, so these are interchangeable — the
# list exists so one host being down costs a retry rather than the upload.
# Comma separated; leave blank for the built-in defaults.
#
# Note: every entry must speak the Blossom protocol (BUD-01/02), not only
# NIP-96. Some popular hosts support one and not the other, so verify a new
# one accepts an upload before putting it first.
VITE_BLOSSOM_SERVERS=
