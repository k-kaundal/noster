# =============================================================================
# NostrFeed Environment Configuration
# =============================================================================
# Copy to `.env` and fill in. Values here are examples, not real credentials.
#
# IMPORTANT: Vite inlines every VITE_-prefixed variable into the built
# JavaScript. Treat all of them as public. Never put a spending key here.
# =============================================================================

# ---------------------------------------------------------------------------
# LNbits (Lightning Wallet Backend)
# ---------------------------------------------------------------------------
# Our LNbits instance. Public.
#
# Signing in with Nostr needs two settings on the LNbits server itself:
#   1. `auth_allowed_methods` must include `nostr-auth-nip98`
#   2. `nostr_absolute_request_urls` must list this origin
VITE_LNBITS_URL=https://ln.nostrfeed.com

# Optional house wallet, used only to receive.
# The invoice key can create invoices and read balance. It cannot spend.
VITE_LNBITS_WALLET_ID=
VITE_LNBITS_INVOICE_KEY=

# ---------------------------------------------------------------------------
# Cashu (Ecash)
# ---------------------------------------------------------------------------
# Cashu mint that issues this app's ecash. Public.
# Must answer NUT-06 (/v1/info), NUT-04 (mint), NUT-05 (melt) over CORS.
VITE_CASHU_MINT_URL=https://mint.nostrfeed.com

# ---------------------------------------------------------------------------
# Lightning Addresses
# ---------------------------------------------------------------------------
# Domain for the LNbits lightning addresses (name@domain).
# Must proxy /.well-known/lnurlp/* through to the LNbits host.
# Safe to leave empty: falls back to the host in VITE_LNBITS_URL.
VITE_LIGHTNING_ADDRESS_DOMAIN=ln.nostrfeed.com

# Any further domains the same LNbits instance issues addresses under.
# Comma-separated. Each needs the same /.well-known/lnurlp/* proxying.
# VITE_LIGHTNING_ADDRESS_DOMAINS=zap.example,pay.example

# Which domains give away free assigned addresses. Defaults to LNbits host.
# VITE_FREE_LIGHTNING_ADDRESS_DOMAIN=
# VITE_FREE_LIGHTNING_ADDRESS_DOMAINS=

# ---------------------------------------------------------------------------
# NIP-05 Verified Names
# ---------------------------------------------------------------------------
# Verified names (NIP-05), sold by the LNbits `nostrnip5` extension.
# Domain ID from the URL of the domain's page in LNbits nostrnip5 extension.
VITE_NIP5_DOMAIN_ID=
VITE_NIP5_DOMAIN=

# Further domains to sell names under, as `id:hostname` pairs, comma separated.
# VITE_NIP5_DOMAINS=1f3c…:nostrfeed.com,9ab2…:zap.example
VITE_NIP5_DOMAINS=

# ---------------------------------------------------------------------------
# Premium / Paid Relay Access
# ---------------------------------------------------------------------------
# LNbits pay link IDs for premium relay access.
# (https://ln.nostrfeed.com/lnurlp/link/<id>)
VITE_PREMIUM_MONTHLY_LINK=
VITE_PREMIUM_LIFETIME_LINK=

# The relay that charges for writes.
# VITE_PAID_RELAY=wss://paid.nostrfeed.com
# Where that relay sells and checks admission, over HTTP.
# VITE_PAID_RELAY_ADMISSION=

# ---------------------------------------------------------------------------
# Fiat Subscriptions (Card / PayPal)
# ---------------------------------------------------------------------------
# Card and PayPal subscriptions, brokered by LNbits' fiat providers.
# Provider must be switched on in LNbits admin settings.
VITE_FIAT_PROVIDER=paypal
VITE_PREMIUM_MONTHLY_FIAT_PLAN=
VITE_PREMIUM_LIFETIME_FIAT_PLAN=

# ---------------------------------------------------------------------------
# Media Upload (Blossom)
# ---------------------------------------------------------------------------
# Blossom media servers, tried in order until one accepts the upload.
# Comma separated; leave blank for the built-in defaults.
# Every entry must speak the Blossom protocol (BUD-01/02).
# VITE_BLOSSOM_SERVERS=https://blossom.example.com,https://cdn.example.com

# ---------------------------------------------------------------------------
# Identity Directory (Optional)
# ---------------------------------------------------------------------------
# Base URL of the GetZap identity API for name search.
# Leave empty and the app makes no requests to it.
# VITE_GETZAP_API=https://api.getzap.me/v1
