# Asset filenames carry a content hash, so a given URL never changes contents
# and may be held forever. Anything that does change must be re-checked, or a
# browser keeps asking for chunk names that the last deploy deleted.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate
