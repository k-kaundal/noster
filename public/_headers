# Asset filenames carry a content hash, so a given URL never changes contents
# and may be held forever. Anything that does change must be re-checked, or a
# browser keeps asking for chunk names that the last deploy deleted.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# The service worker decides what every other request is answered with, so a
# cached copy of it is a cached copy of all the rules. A browser holding an old
# one cannot be told about a new deploy by any means short of clearing storage.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
